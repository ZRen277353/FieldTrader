<Application x:Class="FieldTrader.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FieldTrader">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#DD192338"/><SolidColorBrush x:Key="Accent" Color="#F3BD71"/>
  <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#202B40"/><GradientStop Color="#111B2D" Offset="0.48"/><GradientStop Color="#282236" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#354258"/><GradientStop Color="#222E43" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="OrangeBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EAA44A"/><GradientStop Color="#BF752F" Offset="1"/></LinearGradientBrush>
  <Style TargetType="Window"><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="Background" Value="{StaticResource ShellBrush}"/><Setter Property="Foreground" Value="#EDF3F7"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF3F7"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#8EA6B8"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="PanelBorder" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="#273B47"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="14"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EAF0F5"/><Setter Property="Background" Value="{StaticResource ButtonBrush}"/><Setter Property="BorderBrush" Value="#3B5262"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#E18B42"/><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.32"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource OrangeBrush}"/><Setter Property="BorderBrush" Value="#F3BD71"/></Style>
  <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="#A3BCCF"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="Background" Value="#101F2A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#35485B"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="#DDE8F0"/><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#0A1922" BorderBrush="#304855" BorderThickness="1" CornerRadius="4"><TextBlock Text="⌄" Foreground="#9CC3D9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="#12232D" BorderBrush="#405A6B" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#D7E3EC"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="#0A1720"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#405C6C" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/></Trigger></Style.Triggers></Style>
  <DataTemplate x:Key="ItemArt"><Grid><local:ItemPlaceholder Kind="{Binding ArtKind}" Opacity="0.85"><local:ItemPlaceholder.Style><Style TargetType="local:ItemPlaceholder"><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:ItemPlaceholder.Style></local:ItemPlaceholder><Image Source="{Binding Image}" Stretch="Uniform" Margin="8"/><TextBlock Text="待导入图片" FontSize="10" Foreground="#718B9F" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate>
  <DataTemplate x:Key="CandidateTemplate"><Border x:Name="Card" Background="#071720" BorderBrush="#294554" BorderThickness="1" CornerRadius="5" Padding="11" Margin="0,0,10,0" Width="190" Height="236" VerticalAlignment="Top"><StackPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemArt}" Height="112"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,9,0,8" TextTrimming="CharacterEllipsis"/><Border HorizontalAlignment="Left" Background="#332718" BorderBrush="#7E542E" BorderThickness="1" CornerRadius="7" Padding="7,2"><TextBlock Text="{Binding Tag}" Foreground="#E3AB6B" FontSize="10"/></Border><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><ProgressBar Value="{Binding Score,Mode=OneWay}" Maximum="100" Height="7" Foreground="#F3BD71" Background="#233B4C" BorderThickness="0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ScoreLabel}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/></Grid></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Highlight}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#FF922D"/><Setter TargetName="Card" Property="Effect"><Setter.Value><DropShadowEffect Color="#EF6F0A" ShadowDepth="0" BlurRadius="11" Opacity="0.4"/></Setter.Value></Setter></DataTrigger></DataTemplate.Triggers></DataTemplate>
  <DataTemplate x:Key="HudCandidateTemplate"><StackPanel Width="114" Margin="0,0,10,0"><Border x:Name="Tile" Height="104" Background="#071720" BorderBrush="#304957" BorderThickness="1" CornerRadius="5"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemArt}"/></Border><TextBlock Text="{Binding Name}" TextAlignment="Center" FontWeight="SemiBold" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LayoutLabel}" Foreground="#91ABBC" FontSize="10" TextAlignment="Center" Margin="0,0,0,3"/><TextBlock Text="{Binding ScoreLabel}" Foreground="#FF982F" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding Highlight}" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#F8902F"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
  <DataTemplate x:Key="CompactCandidateTemplate"><Border Background="#0A1A24" BorderBrush="#334957" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,8,0" Width="94"><StackPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemArt}" Height="48"/><TextBlock Text="{Binding ScoreLabel}" Foreground="#FF982F" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate>
  <DataTemplate x:Key="HistoryTemplate"><Border BorderBrush="#213540" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="53"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#0C1C26" BorderBrush="#A16A2E" BorderThickness="1" CornerRadius="4" Height="49"><Grid><local:ItemPlaceholder Kind="{Binding Candidate.ArtKind}"/><Image Source="{Binding Candidate.Image}" Stretch="Uniform" Margin="4"/></Grid></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Time}" Foreground="#92ADC0" FontSize="11"/><TextBlock Text="{Binding Name}" Margin="0,4,0,3" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#91A9BA" FontSize="10"/></StackPanel></Grid></Border></DataTemplate>
 </Application.Resources>
</Application>



