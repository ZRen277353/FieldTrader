<Window x:Class="FieldTrader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FieldTrader" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="战地行商 · 听声识物" Width="1150" Height="970" MinWidth="860" MinHeight="725" WindowStyle="None" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="7" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border Background="{StaticResource ShellBrush}" BorderBrush="#526773" BorderThickness="1" CornerRadius="7" Padding="12,0,12,0"><Viewbox Stretch="Uniform"><Grid Width="1120" Height="944"><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="52"/><RowDefinition Height="298"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <local:HachimiBackdrop Grid.RowSpan="5" IsHitTestVisible="False" ClipToBounds="True"/>
  <Grid MouseLeftButtonDown="DragWindow" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Path Stroke="#48D8FA" StrokeThickness="2.5" Data="M0,20 L5,20 M8,12 L8,28 M13,5 L13,36 M18,15 L18,26 M23,0 L23,42 M28,9 L28,32 M33,14 L33,28 M38,18 L43,18" Width="45" Height="42" Margin="0,0,17,0"/><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="战地行商 · 听声识物" FontWeight="SemiBold" FontSize="23"/><TextBlock Text="v0.9.1" Foreground="#7E98A9" Margin="16,8,0,0"/></StackPanel><TextBlock Text="Arena Breakout: Infinite  |  Audio Item Recognition Tool" Foreground="#839DAC" FontSize="12" Margin="0,7,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="30"><Button Style="{StaticResource ChromeButton}" Content="─" Click="Minimize" ToolTip="最小化"/><Button Style="{StaticResource ChromeButton}" Content="□" Click="Maximize" ToolTip="最大化 / 还原"/><Button Style="{StaticResource ChromeButton}" Content="✕" Click="ExitApp" ToolTip="退出软件"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,4,0"><Button Content="▱  最小化窗口" Click="Minimize"/><Button Style="{StaticResource OrangeButton}" Content="▣  开启游戏悬浮窗" Click="OpenOverlay"/></StackPanel></StackPanel></Grid>
  <Border Grid.Row="1" BorderBrush="#2B404B" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Button Content="⌂  首页" Width="106" Style="{StaticResource OrangeButton}" Background="#442C1B" Click="GoHome"/><Button Content="▦  物品数据库" Width="145" Background="Transparent" BorderBrush="#20343E" Click="OpenCatalog"/><Button Content="▤  识别记录" Width="130" Background="Transparent" BorderBrush="#20343E" Click="ShowHistory"/><Button Content="⚙  软件设置" Width="130" Background="Transparent" BorderBrush="#20343E" Click="Settings"/><Button Content="⌕  音频诊断" Width="135" Background="Transparent" Click="AudioDiagnostics"/><Button Content="♬  游戏语音" Width="145" Background="Transparent" BorderBrush="#20343E" Click="OpenVoiceBoard"/><Button Content="市场巡查" Width="105" Background="Transparent" Click="OpenMarket"/><Button Content="ⓘ  使用说明" Width="145" Background="Transparent" BorderBrush="#20343E" Click="Help"/></StackPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,18,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="51"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="♩" Foreground="#8BCCE4" FontSize="28" Margin="0,0,12,0"/><TextBlock Text="音频监听" Style="{StaticResource Section}"/><Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="23,0,9,0"/><TextBlock Text="{Binding Status}" Foreground="#A9C0CF" VerticalAlignment="Center" FontSize="12" MaxWidth="520" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Text="{Binding ElapsedLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/></DockPanel>
   <Grid Grid.Row="1" Margin="0,3,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="450"/><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><DockPanel><TextBlock Text="音频设备" VerticalAlignment="Center" Margin="0,0,12,0"/><Button DockPanel.Dock="Right" Content="⟳" Foreground="#00DAB5" FontSize="21" Padding="10,0" Margin="8,0,8,0" Click="RefreshDevices" IsEnabled="{Binding CanChooseDevice}"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanChooseDevice}"/></DockPanel><Grid Grid.Column="1" Margin="12,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="捕获电平" VerticalAlignment="Center"/><local:LevelMeter Grid.Column="1" Value="{Binding Level}" Height="16"/><TextBlock Grid.Column="2" Text="{Binding LevelLabel}" Foreground="#90AABA" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid><UniformGrid Grid.Column="2" Columns="2"><Button Content="●  开始监听" Click="StartListening" IsEnabled="{Binding CanStart}"/><Button Content="■  停止监听" Click="StopListening" IsEnabled="{Binding CanStop}" Background="#872925" BorderBrush="#C1473D" Margin="0"/></UniformGrid></Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource PanelBorder}" Padding="10,7"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions><TextBlock Text="实时波形 · 自动显示增益" FontWeight="SemiBold"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid><TextBlock Text="高" FontSize="10" Foreground="#7EA1B5"/><TextBlock Text="0.0" FontSize="10" Foreground="#7EA1B5" VerticalAlignment="Center"/><TextBlock Text="低" FontSize="10" Foreground="#7EA1B5" VerticalAlignment="Bottom"/></Grid><local:WaveformView Grid.Column="1" Samples="{Binding Waveform}"/></Grid><DockPanel Grid.Row="2" Margin="34,4,0,0"><TextBlock Text="较早" FontSize="9" Foreground="#638296"/><TextBlock Text="{Binding DetectionSummary}" FontSize="9" Foreground="#638296" HorizontalAlignment="Right"/></DockPanel></Grid></Border><Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="10,7"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions><DockPanel><TextBlock Text="频谱图（Mel）" FontWeight="SemiBold"/><TextBlock Text="LIVE" Foreground="#6288A5" HorizontalAlignment="Right" FontSize="10"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Stretch"><TextBlock Text="16 kHz" FontSize="10" Foreground="#7EA1B5" Margin="0,0,0,20"/><TextBlock Text="2.7 kHz" FontSize="10" Foreground="#7EA1B5" Margin="0,0,0,20"/><TextBlock Text="0 Hz" FontSize="10" Foreground="#7EA1B5"/></StackPanel><local:SpectrogramView Grid.Column="1" Bands="{Binding Spectrum}"/></Grid><TextBlock Grid.Row="2" Text="真实音频 · 64 个 Mel 频带 · 约 12 秒滚动" Foreground="#638296" FontSize="9" HorizontalAlignment="Right" Margin="0,4,0,0"/></Grid></Border></Grid>
  </Grid></Border>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="128"/></Grid.RowDefinitions><Border Style="{StaticResource PanelBorder}" BorderBrush="#56402C"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions><DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="⬡" Foreground="#FF8C25" FontSize="25" Margin="0,0,10,0"/><TextBlock Text="当前识别结果" Style="{StaticResource Section}"/><Border Background="#8D450E" CornerRadius="11" Padding="10,4" Margin="18,5,0,5"><TextBlock Text="{Binding ResultBadge}" FontSize="11"/></Border></StackPanel><ComboBox ItemsSource="{Binding LayoutOptions}" SelectedItem="{Binding LayoutFilter}" Width="132" Margin="12,4" ToolTip="按参考图片的占格和摆放方向筛选候选"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{Binding MatchLabel}" Foreground="#FF982F" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="1" Visibility="{Binding NoFilterMatchesVisibility}" Text="当前声音组没有此规格，请切换为「全部规格」" Foreground="#8EA6B8" HorizontalAlignment="Center" VerticalAlignment="Center"/><ScrollViewer PreviewMouseWheel="ScrollCandidates" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,7,0,0"><ItemsControl Opacity="{Binding ResultOpacity}" ItemsSource="{Binding DisplayCandidates}" ItemTemplate="{StaticResource CandidateTemplate}" VerticalAlignment="Top"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer><TextBlock Grid.Row="2" Text="{Binding RecognitionStatus}" Foreground="#849CA9" FontSize="11" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/></Grid></Border>
  <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource PanelBorder}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="数据库管理" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal"><Button Content="＋ 添加新物品" Style="{StaticResource OrangeButton}" Background="#442C1B" Click="OpenCatalog" VerticalAlignment="Center"/><StackPanel Margin="7,0,17,0" VerticalAlignment="Center"><TextBlock Text="已添加物品" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding ItemCount}" FontSize="20" Margin="0,3,0,0"/></StackPanel><StackPanel Margin="0,0,17,0" VerticalAlignment="Center"><TextBlock Text="声音样本" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding SampleCount}" FontSize="20" Margin="0,3,0,0"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="声音组" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding GroupCount}" FontSize="20" Margin="0,3,0,0"/></StackPanel></StackPanel></DockPanel></Border><Border Grid.Column="2" Style="{StaticResource PanelBorder}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="快捷操作" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="▷  音频文件测试" Click="Demo" Padding="11,12"/><Button Content="▱  数据文件夹" Click="OpenDataFolder" Padding="11,12" Margin="0"/></StackPanel></DockPanel></Border></Grid></Grid>
  <Border Grid.Column="2" Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><DockPanel><TextBlock Text="最近识别记录" FontWeight="SemiBold" FontSize="15"/><Button Content="♧ 清空" Style="{StaticResource ChromeButton}" Click="ClearHistory" HorizontalAlignment="Right" Padding="2,2" FontSize="11"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding HistoryEntries}" ItemTemplate="{StaticResource HistoryTemplate}"/></ScrollViewer><TextBlock Grid.Row="1" Text="暂无识别记录&#10;&#10;开始监听或测试音频文件" Foreground="#617F91" FontSize="12" Margin="0,20,0,0" Visibility="{Binding EmptyHistoryVisibility}"/></Grid></Border></Grid>
  <Grid Grid.Row="4" Margin="12,12,12,0"><TextBlock Text="作者：取名字真麻烦   ·   抖音：21360166462   ·   QQ：3445838743" Foreground="#ACBDC6" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="免费使用 · 禁止倒卖" Foreground="#EAB779" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center"/></Grid>
 </Grid></Viewbox></Border>
</Window>



