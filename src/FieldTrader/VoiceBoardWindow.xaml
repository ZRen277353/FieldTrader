<Window x:Class="FieldTrader.VoiceBoardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FieldTrader" Style="{StaticResource {x:Type Window}}" Title="游戏语音 · 哈基米主题" Width="1180" Height="940" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterOwner">
 <Grid><local:HachimiBackdrop IsHitTestVisible="False"/><Grid Margin="26,20"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><Border Background="#24374A" CornerRadius="20" Width="66" Height="66" HorizontalAlignment="Left" VerticalAlignment="Top"><local:CatMark Width="58" Height="52" Margin="5,6"/></Border><StackPanel Grid.Column="1"><TextBlock Text="HACHIMI  /  语音工坊" Foreground="#83DCCC" FontSize="11" Margin="0,2,0,5"/><TextBlock Text="把快乐，放进每一句话" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="游戏语音板 · 选一张卡片，即可播放你的音效" Foreground="#A3B4C9" FontSize="12" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,7,0,0"><Border Background="#443823" BorderBrush="#80613A" BorderThickness="1" CornerRadius="12" Padding="12,5" HorizontalAlignment="Right"><TextBlock Text="♫  哈基米主题" Foreground="#F9CE88" FontSize="11"/></Border><TextBlock Text="作者：取名字真麻烦" Foreground="#B4C2D1" FontSize="11" HorizontalAlignment="Right" Margin="0,9,0,0"/><TextBlock Text="免费使用 · 禁止倒卖" Foreground="#91A4BC" FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel></Grid>
 <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,10,0,18" Padding="18,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,12"><TextBlock Text="01   本地试听设备（不传给队友）" Foreground="#A7BCCB" FontSize="11" Margin="0,0,0,7"/><ComboBox x:Name="OutputBox" DisplayMemberPath="Name"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="02   文字朗读音色" Foreground="#A7BCCB" FontSize="11" Margin="0,0,0,7"/><ComboBox x:Name="VoiceBox" DisplayMemberPath="Name"/></StackPanel><WrapPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center"><TextBlock Text="音效音量" FontSize="12" VerticalAlignment="Center"/><Slider x:Name="VolumeSlider" Width="130" Minimum="0" Maximum="100" Margin="12,0"/><TextBlock Text="{Binding Value,ElementName=VolumeSlider,StringFormat={}{0:0}%}" Foreground="#F8D49B" VerticalAlignment="Center" Width="45"/><TextBlock Text="语速" FontSize="12" VerticalAlignment="Center"/><Slider x:Name="RateSlider" Width="100" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="12,0"/><TextBlock Text="{Binding Value,ElementName=RateSlider,StringFormat={}{0:0}}" Foreground="#F8D49B" VerticalAlignment="Center" Width="24"/><CheckBox x:Name="HotkeysEnabled" Content="全局快捷键" IsChecked="True" Foreground="#D5E0EA" VerticalAlignment="Center" Margin="16,0"/><ComboBox x:Name="ShowType" Width="120" SelectedIndex="1" Margin="0,0,12,0"><ComboBoxItem Content="全部条目"/><ComboBoxItem Content="录音音效"/><ComboBoxItem Content="文字朗读"/></ComboBox><TextBlock Text="发言" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="TalkMode" Width="134" SelectedIndex="0" Margin="0,0,7,0"><ComboBoxItem Content="按键说话（自动）"/><ComboBoxItem Content="自由说话"/></ComboBox><TextBox x:Name="TalkKeyBox" Text="T" Width="36" MinHeight="32" Padding="6" Margin="0,0,10,0" ToolTip="游戏说话键，默认T，可改字母、数字或F1～F11"/><Button Content="刷新设备" Click="RefreshDevices" Padding="12,7" Margin="0"/></WrapPanel><Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#405064" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0"><StackPanel><WrapPanel><TextBlock Text="真人麦克风" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" Width="245" Margin="0,0,12,0"/><TextBlock Text="混音送到" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="MixOutputBox" DisplayMemberPath="Name" Width="240" Margin="0,0,12,0"/><Button x:Name="MixToggle" Content="开启麦克风混音" Click="ToggleMicrophoneMix" Padding="12,7" Margin="0"/></WrapPanel><WrapPanel Margin="0,8,0,0"><TextBlock Text="麦克风音量" FontSize="11" VerticalAlignment="Center"/><Slider x:Name="MicrophoneVolume" Width="100" Minimum="0" Maximum="400" IsEnabled="False" ToolTip="开启麦克风混音后，实时调节真人声音" Value="100" Margin="10,0"/><TextBlock Text="{Binding Value,ElementName=MicrophoneVolume,StringFormat={}{0:0}%}" Foreground="#F8D49B" VerticalAlignment="Center" Width="42"/><TextBlock Text="发送增强" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/><Slider x:Name="TransmitBoost" Minimum="1" Maximum="8" Value="2" Width="85" Margin="8,0" IsEnabled="False" ToolTip="仅放大送进游戏的真人声与音效，含峰值保护"/><TextBlock Text="{Binding Value,ElementName=TransmitBoost,StringFormat={}×{0:0.0}}" FontSize="11" Foreground="#F8D49B" VerticalAlignment="Center" Width="34"/><TextBlock Text="发送电平" FontSize="10" VerticalAlignment="Center"/><ProgressBar x:Name="MicrophoneMeter" Width="65" Height="6" Maximum="1" Margin="8,0,12,0" Foreground="#83DCCC" Background="#304155"/><TextBlock x:Name="SendLevel" Width="64" Text="未发送" FontSize="10" Foreground="#83DCCC" VerticalAlignment="Center"/><TextBlock x:Name="MixStatus" Text="仅本地试听 · 尚未向游戏发送" FontSize="11" Foreground="#83DCCC" VerticalAlignment="Center"/><Button Content="安装虚拟麦克风" Click="InstallCableDriver" Style="{StaticResource ChromeButton}" FontSize="10" Padding="10,3" Margin="6,0,0,0"/><Button Content="VB-CABLE 官网 / 支持作者 ↗" Click="OpenCableGuide" Style="{StaticResource ChromeButton}" FontSize="10" Padding="10,3" Margin="6,0,0,0"/></WrapPanel></StackPanel></Border></Grid></Border>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
 <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions><DockPanel><TextBlock Text="我的声音收藏" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Items.Count,ElementName=PhraseGrid,StringFormat={}  /  {0} 个声音}" Foreground="#90A8BC" VerticalAlignment="Center" FontSize="11"/></DockPanel>
 <ListBox x:Name="PhraseGrid" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Background="Transparent" BorderThickness="0" Padding="0,0,3,0">
  <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,9,11"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="#E61A263B" BorderBrush="#3A485E" BorderThickness="1" CornerRadius="15"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#28344B"/><Setter TargetName="Tile" Property="BorderBrush" Value="#75BEB2"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#343346"/><Setter TargetName="Tile" Property="BorderBrush" Value="#F4C47C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
  <ListBox.ItemTemplate><DataTemplate><Grid Margin="14" Height="148"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="30"/><RowDefinition/><RowDefinition Height="31"/></Grid.RowDefinitions><DockPanel><Border Background="#2A4B50" CornerRadius="9" Width="30" Height="30" HorizontalAlignment="Left"><TextBlock Text="{Binding Glyph}" Foreground="#8CE0CB" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding KindLabel}" Foreground="#9AAFC3" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/></DockPanel><TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="2" Text="{Binding Note}" ToolTip="{Binding Note}" Foreground="#B5C3D4" FontSize="11" TextWrapping="Wrap" MaxHeight="36" VerticalAlignment="Top" Margin="0,7,0,5"/><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Border Background="#111D30" CornerRadius="6" Padding="6,5" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="145"><TextBlock Text="{Binding HotkeyLabel}" FontSize="10" Foreground="#EACA93" TextTrimming="CharacterEllipsis"/></Border><Button Grid.Column="1" Content="▶" Click="PlayRow" ToolTip="播放这段声音" Style="{StaticResource OrangeButton}" Margin="3,0,0,0" Padding="6,4"/></Grid></Grid></DataTemplate></ListBox.ItemTemplate>
 </ListBox>
 <DockPanel Grid.Row="2" Margin="0,6,0,0"><Button Content="＋ 添加短句" Click="AddPhrase" Padding="13,8"/><Button Content="删除选中" Click="DeletePhrase" Padding="13,8" Background="Transparent"/><Button Content="■  停止播放" Click="StopPlayback" Background="#603A41" BorderBrush="#A26C6D" Padding="15,8" HorizontalAlignment="Right" Margin="0"/></DockPanel>
 </Grid>
 <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="18" Background="#E51A2538"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SelectedItem,ElementName=PhraseGrid}"><TextBlock Text="声音小档案" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="选中左侧卡片，即可在这里修改" Foreground="#93ABC1" FontSize="10" Margin="0,7,0,14"/><TextBlock Text="名称" FontSize="11" Foreground="#B8C8D7"/><TextBox Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="中文含义 / 用途" FontSize="11" Foreground="#B8C8D7"/><TextBox Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="54"/><TextBlock Text="文字朗读内容" FontSize="11" Foreground="#B8C8D7"/><TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="48"/><TextBlock Text="快捷键" FontSize="11" Foreground="#B8C8D7"/><TextBox Text="{Binding Hotkey,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding WavLabel}" Foreground="#82D9C5" FontSize="11" Margin="0,0,0,12"/><UniformGrid Columns="2"><Button Content="导入 WAV" Click="ImportWav" Padding="7,9"/><Button Content="清除录音" Click="ClearWav" Padding="7,9" Margin="0"/></UniformGrid><TextBlock Text="已导入录音时，优先播放录音。" Foreground="#91A9BF" FontSize="10" TextWrapping="Wrap" Margin="0,13,0,0"/></StackPanel></ScrollViewer><StackPanel Grid.Row="1"><Button Content="播放选中" Click="PlaySelected" Margin="0,13,0,7" Padding="10,11"/><Button Content="保存并应用" Click="SaveSettings" Style="{StaticResource OrangeButton}" Margin="0" Padding="10,11"/></StackPanel></Grid></Border>
 </Grid>
 <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Foreground="#F1CB91" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/><Expander Header="如何让队友听到？" Foreground="#A9BFD1" FontSize="11"><TextBlock TextWrapping="Wrap" Foreground="#9BB1C7" Margin="0,10,0,0" Text="试听：播放到选择耳机。传入游戏：本软件选 CABLE Input，游戏麦克风选 CABLE Output，需已有虚拟音频线路。按键说话模式：游戏前台时自动按住 T（可修改）并播放，结束后松开；自由说话模式无需按键。开启“麦克风混音”后，真人说话与音效会一起送到虚拟线路；游戏麦克风需选择对应 CABLE Output。关闭混音或退出软件后，不再转发真人麦克风。隐藏此窗口后快捷键仍有效，退出主程序后结束。"/></Expander></StackPanel>
 </Grid></Grid>
</Window>
